{
  "project_name": "Generic 8-bit ALU Example",
  "build_dir": "build",
  "reports_dir": "reports",
  "simulator": "icarus",
  "timeout_seconds": 5.0,
  "reference_sources": {
    "primary": {
      "name": "golden_alu8",
      "path": "golden_alu8.csv",
      "priority": 1,
      "type": "direct_io_table",
      "format": "csv",
      "radix": "hex",
      "input_mapping": {
        "a": "a",
        "b": "b",
        "opcode": "opcode"
      },
      "output_mapping": {
        "expected_result": "result",
        "expected_zero": "zero"
      },
      "timing": {
        "mode": "combinational",
        "settling_time_ns": 5.0
      }
    }
  }
}
